{
  "name": "click-eat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "python3 -m uvicorn backend.main:create_app --factory --host 127.0.0.1 --port 4173 --no-proxy-headers",
    "test": "python3 -m pytest",
    "build": "node scripts/build.mjs",
    "test:performance": "node scripts/performance.mjs",
    "start:legacy": "node server/local.mjs",
    "test:legacy": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2"
  }
}
